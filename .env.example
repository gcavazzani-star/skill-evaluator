# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# Chave de acesso à API (obrigatório)
ANTHROPIC_API_KEY=sk-ant-...

# URL base para proxies corporativos como IARA (opcional)
# Se não definido, usa a API pública da Anthropic
ANTHROPIC_BASE_URL=https://...

# Modelo usado para executar a skill e para o judge (opcional)
# Padrão: anthropic.claude-4-6-sonnet (formato IARA)
SKILL_MODEL=anthropic.claude-4-6-sonnet
