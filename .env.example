# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# Chave de acesso à API (obrigatório)
ANTHROPIC_API_KEY=sk-ant-...

# URL base para proxies corporativos (opcional)
# Se não definido, usa a API pública da Anthropic
# ANTHROPIC_BASE_URL=https://...

# Modelo usado para EXECUTAR a skill (opcional)
# Padrão: claude-sonnet-4-5
# SKILL_MODEL=claude-sonnet-4-5

# Modelo usado para JULGAR os outputs — recomendado ser diferente de SKILL_MODEL
# para evitar self-preference bias (modelo que favorece seus próprios outputs).
# Use um modelo mais capaz como judge para maior confiabilidade.
# Padrão: igual ao SKILL_MODEL se não definido
# JUDGE_MODEL=claude-opus-4-5
